# Admin dashboard. Without these, the dashboard runs as a LOCAL SANDBOX (browser-only, demo data, no auth).
NEXT_PUBLIC_SUPABASE_URL=
# Public anon key ONLY — authorization is enforced by Row Level Security on the database.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Base URL of the student web app, encoded into printed QR checkpoint codes.
NEXT_PUBLIC_STUDENT_APP_URL=http://localhost:3000
