# Leave empty to run on the bundled fictional demo dataset.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Student web app base URL; printed QR codes use https://<host>/q/<token>
EXPO_PUBLIC_SITE_URL=
# Optional: domain for Android App Links / iOS Universal Links (e.g. nav.example.edu)
CAMPUSNAV_LINK_HOST=
# Required for remote push tokens (run `eas init`)
EAS_PROJECT_ID=
