# Student web app. Leave Supabase vars empty to run fully on the fictional demo dataset.
NEXT_PUBLIC_SUPABASE_URL=
# Public anon key ONLY. Never put the service-role key in any NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Public base URL used to build QR checkpoint links (https://<host>/q/<token>)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
